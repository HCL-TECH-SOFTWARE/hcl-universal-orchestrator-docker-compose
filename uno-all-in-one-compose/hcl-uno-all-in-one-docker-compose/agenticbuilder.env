################ COMMON CONFIGURATION ###############
# Keycloak Integration (Used by authlibrary to discover keys)
OIDC_SERVER_URL=https://hcl-uno-keycloak-ssl
OIDC_CLIENT_ID=uno-service
KEYCLOAK_REALM=uno

#Authentiation
ENABLE_AUTHENTICATION=true
DISABLE_AUTHORIZATION=false

ENABLE_TELEMETRY=false
TELEMETRY_BASE_URL=
INFERENCE_ENDPOINT=
TELEMETRY_SERVICE_NAME="executor-service"
TELEMETRY_EXPORT_INTERVAL_MILLIS=60000
PHOENIX_WORKING_DIR="/tmp/"
ENABLE_MULTITENANCY=false
########### END COMMON CONFIGURATION ###########

HCL_AUTHORIZATION_HTTPS___WAJWT_API=/jwt/tls.crt
HCL_AUTHORIZATION_HTTPS___WAJWT_APIGATEWAY=/jwt/tls.crt
HCL_AUTHORIZATION_HTTPS___WAJWT_MCP=/jwt/tls.crt
HCL_AUTHORIZATION_AGENTIC_AI_BUILDER_SYSTEM=/agenticbuilder/jwt/jwt.crt
JWT_PRIVATE_KEY_PATH=/agenticbuilder/jwt/jwt.key
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}

