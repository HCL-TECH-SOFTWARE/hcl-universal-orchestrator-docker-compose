#
# Edit this file before running containers to enable
# connection between Clara and the target environment
#

# Select the models used
LLM="gemini-2.5-flash"
EMBED_MODEL="BGE-SMALL-EN"

# Select the type of rag method to used from backend
RAG_TYPE="RERANK"
#Channel Slack
SLACK_TOKEN=
SLACK_CHANNEL=
SLACK_SIGNING_SECRET=

#Channel Google
GOOGLE_PROJECT_ID=

#Channel Teams
BOTFRAMEWORK_APP_ID=
BOTFRAMEWORK_APP_PASSWORD=

# Models keys
GOOGLE_APPLICATION_CREDENTIALS_JSON=
REGION=
OPENAI_API_KEY=""
REST_CHANNEL=rasa_custom_components.rest_auth_channel.RestAuthInput
GOOGLE_PROJECT_ID=test
POSTGRES_HOST=hcl-uno-pgvector
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT=
POSTGRES_OPTIONS=
POSTGRES_REQUIRE_AUTH=
POSTGRES_APPLICATION_NAME=
POSTGRES_SSL_MODE=disable
POSTGRES_SSL_VERIFY=true
POSTGRES_SSL_VERIFY_HOSTNAME=
POSTGRES_CA_PATH=
POSTGRES_CERT_PATH=
POSTGRES_CERT_KEY_PATH=
POSTGRES_CERT_KEY_PASSWORD=
POSTGRES_CERT_CA_PATH=
POSTGRES_CERT_CA_FOLDER_PATH=
POSTGRES_TRUSTSTORE_CA_FOLDER_PATH=
POSTGRES_TRUSTSTORE_CA_CERTIFICATE_PATHS=
POSTGRES_TRUSTSTORE_CA_CERTIFICATE=
POSTGRES_TRUSTSTORE_PROTOCOL=
SQL_TRACKER_STORE_SSL_MODE=${POSTGRES_SSL_MODE}
SQL_TRACKER_STORE_SSL_ROOT_CERTIFICATE=${POSTGRES_CA_PATH}
PASSWORD_TRACKERSTORE=${POSTGRES_PASSWORD}
PASSWORD_LOCKSTORE=${POSTGRES_PASSWORD}

ROOT_CA_FOLDER=/security/certs
#NGINX CONFIG
PILOT_UI_URL=https://hcl-uno-pilot-ui:3000
PILOT_CORE_URL=https://hcl-uno-pilot-core:5005
PILOT_ACTIONS_URL=https://hcl-uno-pilot-actions:5055
PILOT_NLG_URL=https://hcl-uno-pilot-nlg:5001
PILOT_BACKEND_URL=https://hcl-uno-pilot-backend:9999
PILOT_TRANSLATOR_URL=https://hcl-uno-pilot-translator:6666
PILOT_NOTIFICATION_URL=https://hcl-uno-console-aio:8443

#ENGINEINFO
ENGINE_HOST=hcl-uno-console-aio
ENGINE_PORT=8443

#RAG AUTHORIZATION/AUTHENTICATION CONFIG
UNO_GATEWAY_HOST="https://hcl-uno-console-aio"
UNO_GATEWAY_PORT="8443"
UNO_ROLE="AI_PILOT_ADMINISTRATOR"
JWT_PRIVATE_KEY_PEM_PATH=/jwt/tls.key
PUBLIC_KEY_CERT_PATH=/jwt/tls.crt
HCL_AUTHORIZATION_HTTPS___PILOT_CORE_5005=/jwt/tls.crt
HCL_AUTHORIZATION_HTTPS___WAJWT_API=/jwt/tls.crt
HCL_AUTHORIZATION_HTTPS___WAJWT_APIGATEWAY=/jwt/tls.crt
OIDC_SERVER_URL=https://hcl-uno-keycloak-ssl
OIDC_CLIENT_ID=uno-service
KEYCLOAK_REALM=uno
LOG_LEVEL="INFO"

POSTGRES_PASSWORD=${POSTGRES_PASSWORD}